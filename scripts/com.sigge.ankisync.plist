<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sigge.ankisync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/DITT_ANVANDARNAMN/scripts/sigge-anki-sync.sh</string>
  </array>
  <!-- Runs every 15 min; the script itself no-ops instantly if Anki isn't
       open, so this is effectively "syncs shortly after you open Anki,
       keeps updating while it's open, does nothing while it's closed". -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/sigge-anki-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sigge-anki-sync.err.log</string>
</dict>
</plist>
